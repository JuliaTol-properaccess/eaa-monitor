{
  // Cloudflare Worker die bezwaren tegen vermelding automatisch verwerkt.
  // Zie DEPLOY.md voor de volledige uitrolstappen (secrets, e-maildomein, PAT).
  "name": "eaa-bezwaar",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",

  // E-mail versturen vanuit de Worker. Het from-domein moet eerst onboarden:
  //   npx wrangler email sending enable eaa-monitor.nl
  "send_email": [{ "name": "EMAIL" }],

  // Opslag van bevestigde nieuwsbrief-inschrijvingen (route /newsletter, sleutel
  // sub:<email>), van de rate-limit-tellers per IP (sleutel rl:<route>:<ip>,
  // met TTL) en van de eregalerij (hof:pending:<uuid>, hof:vote:<slug>:<hash>,
  // hof:count:<slug>). Maak de namespace eenmalig aan en vul het id hieronder in (zie DEPLOY.md):
  //   npx wrangler kv namespace create NEWSLETTER
  "kv_namespaces": [{ "binding": "NEWSLETTER", "id": "9bee247149b64408835caa8ca1761d18" }],

  "vars": {
    // Alleen het dashboard mag de Worker aanroepen (CORS).
    "ALLOWED_ORIGIN": "https://eaa-monitor.nl",

    // Afzender van de bevestigingsmail. Domein moet onboarded zijn (zie boven).
    "FROM_EMAIL": "bezwaar@eaa-monitor.nl",
    "FROM_NAME": "EAA Monitor",

    // Afzender van de nieuwsbrief-bevestigingsmail. Zelfde onboarded domein.
    // Niet gezet? Dan valt /newsletter terug op FROM_EMAIL.
    "NEWSLETTER_FROM": "nieuwsbrief@eaa-monitor.nl",

    // Waar handmatige-check-meldingen heen gaan (geen domeinmatch).
    // Dit adres is ook de reply-to op de bevestigingsmails. Het ontvangt mail
    // via Cloudflare Email Routing, dat het doorstuurt naar de echte inbox.
    "NOTIFY_EMAIL": "info@eaa-monitor.nl",

    // Eigen postbus voor anonieme EAA-vragen (route POST /vraag). Zo blijven
    // vragen gescheiden van bezwaren en artikelfeedback. Maak dit adres aan via
    // Cloudflare Email Routing (zie DEPLOY.md). Niet gezet? Dan valt /vraag
    // terug op NOTIFY_EMAIL.
    "VRAGEN_EMAIL": "vragen@eaa-monitor.nl",

    // Doel-repo voor de commits naar data/objections.json en data/halloffame.json.
    "GITHUB_REPO": "JuliaTol-properaccess/eaa-monitor",
    "GITHUB_BRANCH": "main",

    // Live JSON van de eregalerij; de stemroute valideert hiertegen welke
    // vermeldingen bestaan, zonder GitHub-call.
    "HOF_DATA_URL": "https://eaa-monitor.nl/data/halloffame.json"
  }

  // Secrets (NIET hier, via `wrangler secret put`):
  //   SIGNING_SECRET  — willekeurige string voor de HMAC-handtekening
  //   GITHUB_TOKEN    — fine-grained PAT, Contents + Pull requests: read & write
}
